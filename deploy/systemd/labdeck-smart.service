[Unit]
Description=LabDeck fixed SMART snapshot helper
After=local-fs.target

[Service]
Type=oneshot
User=root
Group=labdeck-readers
ExecStart=/usr/local/bin/labdeck-collector -config /etc/labdeck/collector.json -smart-once
TimeoutStartSec=130s
UMask=0027
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/var/lib/labdeck-collector/public/smart
MemoryMax=128M
TasksMax=16
